<?xml version="1.0" encoding="UTF-8" ?>

<phpdocumentor configVersion="3">

    <title>Documentació tècnica Laravel</title>

    <files>
        <directory>app</directory>
        <directory>routes</directory>

        <ignore>
            vendor/*
            storage/*
            bootstrap/cache/*
        </ignore>
    </files>

    <settings>
        <setting name="visibility" value="public,protected"/>
        <setting name="defaultpackagename" value="Application"/>
    </settings>

    <transformations>
        <template name="clean"/>
    </transformations>

</phpdocumentor>